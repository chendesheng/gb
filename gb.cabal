cabal-version:      3.8
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'gb' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               gb

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            NONE

-- The package author(s).
author:             chendesheng

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         ichendesheng@gmail.com

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

extra-source-files:
    app/Info.plist
    app/NativeMenu.h
    resources/battery-prompts.md
    resources/logo.png
    scripts/build-macos-app.sh
    test/fixtures/dmg-acid2/README.md
    test/fixtures/dmg-acid2/LICENSE
    test/fixtures/dmg-acid2/dmg-acid2.gb
    test/fixtures/dmg-acid2/reference-dmg.png

data-files:
    resources/device.png
    resources/battery-off.png
    resources/battery-on.png
    resources/dmg.bin

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wcompat

common shared
    -- Base language which the package is written in.
    default-language: Haskell2010
    default-extensions:  OverloadedStrings, OverloadedRecordDot, DuplicateRecordFields, NamedFieldPuns, BinaryLiterals

library gb-lib
    -- Import common warning flags.
    import:           warnings, shared
    ghc-options: -fprof-auto -Wno-unused-top-binds
    exposed-modules: Instruction, Color, Bus, CPU, PPU, APU, Registers, Emulator
    other-modules: Dbg
    -- Directories containing source files.
    hs-source-dirs:   src

    -- Test dependencies.
    build-depends:    base ^>=4.21.0.0, bytestring, binary, vector, vector-algorithms, split, deque, stm

executable gb-exe
    import:           warnings, shared
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:    Paths_gb, NativeMenu
    autogen-modules:  Paths_gb
    ghc-options:      -threaded -rtsopts
    build-depends:    base ^>=4.21.0.0, directory, filepath, h-raylib ^>=6.1.0.0,
                     inline-c-objc ^>=0.1.0.0, bytestring, vector, gb:gb-lib
    include-dirs:    app
    frameworks:      AppKit, UniformTypeIdentifiers

test-suite gb-test
    -- Import common warning flags.
    import:           warnings, shared
    ghc-options: -fprof-auto -rtsopts


    -- Modules included in this executable, other than Main.
    other-modules: InstructionSpec, CPUSpec, PPUSpec, EmulatorSpec

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Spec.hs

    -- Test dependencies.
    build-depends:    base ^>=4.21.0.0, hspec, binary, bytestring, vector,
                      JuicyPixels, directory, gb:gb-lib


    build-tool-depends:
        hspec-discover:hspec-discover
